<?xml version="1.0" encoding="utf-8"?>
<!-- Reads screen text only to find Reels/Shorts and adult content. Nothing is stored or sent;
     the app has no internet permission. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewScrolled|typeViewTextChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagIncludeNotImportantViews"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="150"
    android:description="@string/service_desc" />
